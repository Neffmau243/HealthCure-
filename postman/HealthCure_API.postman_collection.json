                  "    pm.expect(response.rol).to.eql('usuario');",
                  "    pm.expect(response).to.not.have.property('password_hash');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Mi Perfil - /me",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "description": "Obtiene los datos del usuario autenticado. Requiere token JWT."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Perfil obtenido (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var response = pm.response.json();",
                  "    pm.expect(response).to.have.property('email');",
                  "    pm.expect(response).to.not.have.property('password_hash');",
                  "    console.log(response.nombre + ' (' + response.email + ') - rol: ' + response.rol);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Mi Perfil - Sin token (debe fallar)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Prueba de acceso sin token. Debe retornar 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Error 401 - No autenticado', function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
