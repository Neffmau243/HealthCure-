          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/evaluaciones/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "evaluaciones", "1"]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "description": "Obtiene la evaluacion con ID 1."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [                  "    pm.test('Evaluacion ID 1 (200)', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var response = pm.response.json();",
                  "    pm.expect(response.id).to.eql(1);",
