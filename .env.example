# ============================================================
# HealthCure - CardioPredict
# Variables de entorno — edita con tus credenciales reales
# ============================================================

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password_aqui
DB_NAME=healthcure_db

# --- JWT (autenticación) ---
# IMPORTANTE: Cambia esta clave en producción
JWT_SECRET_KEY=cambia-esta-clave-super-secreta-para-produccion
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Orígenes permitidos para el frontend, separados por coma.
# "*" = cualquier origen (SOLO para desarrollo)
# En producción pon la URL real del frontend, ej:
# CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=*

# --- App ---
DEBUG=True

# --- ML Model ---
MODEL_PATH=app/resources/modelo_cardiaco.joblib
